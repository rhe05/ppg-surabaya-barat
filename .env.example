# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. See extract_engine.js header comment for context.

# Path to a Google Cloud service account JSON key file, granted:
#   - Viewer access to the target Google Sheet (share the Sheet with the
#     service account's email address, same as sharing with a person)
#   - Firestore read access (Cloud Firestore User / Viewer role) on the
#     project the app's Firestore data lives in
# This is a DIFFERENT credential from the one the live Apps Script app uses
# (that one lives in Apps Script Script Properties as
# FIRESTORE_SERVICE_ACCOUNT_JSON and is intentionally never in git — see
# RUANG_NGAJI_EXTRACTION_TOPOLOGY.md §3). You'll need to create a new service
# account (or reuse that one's underlying GCP project) via the GCP Console:
# IAM & Admin > Service Accounts > Create > download a JSON key.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# The Google Sheet's spreadsheet ID (the long string in its URL between
# /d/ and /edit). NOT stored anywhere in this repo by design (container-bound
# script) — get it from the Sheet's URL directly, or from Apps Script editor
# (Extensions > Apps Script > any file > the bound Sheet is shown in the
# project's file list / can be opened via "Container").
SPREADSHEET_ID=

# Optional — defaults to the service account key's own project_id field if
# omitted. Only set this if extracting from a Firestore project different
# from the one the service account key belongs to.
FIRESTORE_PROJECT_ID=
